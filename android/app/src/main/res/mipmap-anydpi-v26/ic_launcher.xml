<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <!--
    No <inset> here: assets/icon/app_icon_foreground.png already reserves the
    adaptive-icon safe-zone margin (artwork ~52% of the canvas), so the launcher
    mask won't clip it. Adding the generator's default 16% inset on top would
    shrink the artwork too much.
  -->
  <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
